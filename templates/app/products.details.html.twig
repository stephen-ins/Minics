{% extends 'base.html.twig' %}

{% block title %}
	Minics | Details
{% endblock %}

{% block body %}
	<div class="container my-5">
		<div class="row">


			<div class="col-md-6 d-flex justify-content-center align-items-center">
				<img src="{{ asset('uploads/images/' ~ product.picture) }}" class="img-fluid" alt="{{ product.title }}">
			</div>


			<div class="col-md-6">
				<h1>{{ product.title }}</h1>
				<p class="text-muted">Référence :
					{{ product.reference }}</p>

				<p>{{ product.description }}</p>

				<div class="row">
					<div class="col-md-6 my-3">
						<strong>Catégorie :
						</strong>
						{{ product.category.title }}
					</div>

					<div class="col-md-6 my-3">
						<strong>Couleur :
						</strong>
						{{ product.color }}
					</div>

					<div class="col-md-6 my-3">
						<strong>Mémoire :
						</strong>
						{{ product.size }}
					</div>

					<div class="col-md-6 my-3">
						<strong>Genre :
						</strong>
						{{ product.gender }}
					</div>
				</div>

				<div class="my-3">
					<h3>
						<strong>{{ product.price }}
							€</stong>
					</h3>
				</div>


				<div class="quantity-selector mt-3 mb-3">
					{% if product.stock > 0 %}

						<form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post">
							<label for="quantity" class="form-label">Quantité:</label>

							<div
								class="input-group" style="width: 150px;">

								{# <input type="number" class="form-control text-center" id="quantity" name="quantity" min="1" max="{{ product.stock }}" value="1"> #}

								<select name="quantity" id="quantity" class="form-control text-center" style="max-width: 80px;">
									{% for item in 1..product.stock %}
										{# mettre une butée de commande à 10 articles maximum #}
										{# {% if item <= product.stock and item <= 10 %} #}
											<option value="{{ item }}"> {{ item }}</option>
										{# {% endif %} #}
									{% endfor %}
								</select>

							</div>
						{% endif %}


						{% if product.stock == 0 %}
							<br>
							<span class="badge bg-danger">Rupture de stock</span>

						{% elseif product.stock <= 5 %}
							<br>
							<small class="text-warning">Il reste seulement
								<strong>{{ product.stock }}</strong>
								articles en stock</small>

						{% else %}
							<br>
							<small class="text-success">Il reste
								<strong>{{ product.stock }}</strong>
								articles en stock</small>
						{% endif %}

					</div>


					<a href="{{ path('app_home') }}" class="btn btn-secondary mt-3">Retour</a>
					<button type="submit" class="btn btn-dark mt-3">Ajouter au panier</button>
				</form>


			</div>


		</div>
	</div>
{% endblock %}
