{% extends 'base.html.twig' %}

{% block title %}

	Minics | Boutique

{% endblock %}

{% block body %}


	<!-- product section -->

	<section class="product_section layout_padding">
		<div class="container">
			<div class="heading_container heading_center">
				<h2>La boutique</h2>
				<h4 class="text-muted" style="color: #6c757d;">Une selection de produits high-tech dernier cri</h4>
			</div>
			<div
				class="row">


				{# ---------- Card ---------- #}


				{% for product in products %}


					<div class="col-sm-6 col-lg-4">
						<div class="box">
							<div class="img-box">
								<img src="{{asset('uploads/images/'~ product.picture)}}" alt=""/>
								<a href="{{ path('app_products_details', {'id': product.id}) }}" class="add_cart_btn">
									<span>
										Voir le détail
									</span>
								</a>
							</div>
							<div class="detail-box">
								<h5>{{ product.title }}</h5>

								<div class="mb-2">
									{% if product.stock == 0 %}
										<br>
										<span class="badge bg-danger">En rupture de stock</span>

									{% elseif product.stock <= 2 %}
										<br>
										<small class="text-warning">Il reste seulement
											<strong>{{ product.stock }}</strong>
											articles</small>

									{% else %}
										<br>
										<small class="text-success">Il reste
											<strong>{{ product.stock }}</strong>
											articles</small>
									{% endif %}
								</div>


								<div class="product_info">
									<h5>
										<span>
											Prix en € :
										</span>
										<strong>
											{{ product.price }}</h5>
									</strong>
									<div class="star_container">
										<i class="fa fa-star" aria-hidden="true"></i>
										<i class="fa fa-star" aria-hidden="true"></i>
										<i class="fa fa-star" aria-hidden="true"></i>
										<i class="fa fa-star" aria-hidden="true"></i>
										<i class="fa fa-star" aria-hidden="true"></i>
									</div>
								</div>
							</div>
						</div>
					</div>

				{% endfor %}


				{# Redirection vers le panier #}

			</div>
			<div class="btn_box">
				<a href="{{path('app_cart')}}" class="view_more-link">
					Voir votre panier
				</a>
			</div>
		</div>
	</section>

	<!-- end product section -->


{% endblock %}
