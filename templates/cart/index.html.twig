{% extends 'base.html.twig' %}

{% block title %}Minics | Votre panier
{% endblock %}

{% block body %}

	<div class="container mt-4">
		<h1 class="text-center mb-4">
			<i class="fa-solid fa-cart-shopping me-2"></i>Votre panier</h1>
	</div>

	<div
		class="container my-5">


		{# sucess, OBJET MESSAGE #}
		{% for label, messages in app.flashes(['success', 'danger', 'warning']) %}

			{# 'le message' in OBJET MESSAGE #}
			{% for message in messages %}

				{# bg-success #}
				{# bg-danger #}
					<div class="bg-{{ label }} text-white p-3 mb-3"> {{ message|raw }}
				</div>

			{% endfor %}

		{% endfor %}


		<table class="table table-borderless">
			<thead>
				<tr>
					<th>Photo</th>
					<th>Titre</th>
					<th>Référence</th>
					<th>Catégorie</th>
					<th>Quantité</th>
					<th>Prix unitaire</th>
					<th>Prix total</th>
					<th></th>
				</tr>

			</thead>
			<tbody>

				{% if dataCart is empty %}

					<tr class="align-middle">

						<td colspan="7" class="text-center">Aucun article dans le panier</td>

					</tr>

				{% else %}
					{% for item in dataCart %}
						<tr class="align-middle">
							<td><img src="{{ asset('uploads/images/' ~ item.product.picture) }}" alt="{{ item.product.title }}" style="max-width: 50px;"></td>

							<td>{{ item.product.title }}</td>
							<td>{{ item.product.reference }}</td>
							<td>{{ item.product.category.title }}</td>
							<td>
								<form action="{{ path('app_cart_update', {'id': item.product.id}) }}" method="post" class="d-inline">
									<select name="quantity" class="form-select form-select-sm" style="width: 80px;" onchange="this.form.submit()">
										{% for i in 1..item.product.stock %}
											<option value="{{ i }}" {% if i == item.quantity %} selected {% endif %}>{{ i }}</option>
										{% endfor %}
									</select>
								</form>
							</td>

							<td>{{ item.product.price }}
								€</td>
							<td>{{ item.product.price * item.quantity }}
								€</td>
							<td>
								<button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#exampleModal{{ item.product.id }}">
									<i class="fa-solid fa-trash-can"></i>

								</button>
							</td>
							<td></td>
							<td></td>
							<td></td>
						</tr>


						<!-- Modal -->
						<div class="modal fade" id="exampleModal{{ item.product.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
							<div class="modal-dialog">
								<div class="modal-content">
									<div class="modal-header">
										<h1 class="modal-title fs-5" id="exampleModalLabel">
											<span class="text-danger">SUPPRIMER</span>
											l'article
											<strong>{{ item.product.title }}</strong>
										</h1>
										<button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										Voulez-vous vraiment supprimer cet article ?
									</div>
									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
										<a href="{{ path('app_cart_remove', {'id': item.product.id}) }}" class="btn btn-danger">Supprimer</a>
									</div>
								</div>
							</div>
						</div>


					{% endfor %}

					<tr>
						<th>MONTANT TOTAL</th>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						<th></th>
						<th class="text-success">{{ total }}
							€
						</th>
						<th></th>


					</tr>


				{% endif %}
			</tbody>
		</table>

		{% if dataCart is not empty %}
			<div class="text-center mt-5">
				{% if app.user %}
					<a href="{{path('app_cart_payment')}}" class='btn btn-success btn-lg px-4'>
						<i class="fa-brands fa-cc-visa me-1"></i>
						<i class="fa-brands fa-cc-mastercard me-1"></i>
						<i class="fa-solid fa-credit-card me-2"></i>VALIDER LE PAIEMENT
					</a>
					<button type="button" class="btn btn-secondary btn-lg px-4" data-toggle="modal" data-target="#cart-modal-delete">
						<i class="fa-solid fa-trash-can"></i>
						VIDER LE PANIER</button>

					<!-- Modal -->
					<div class="modal fade" id="cart-modal-delete" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h1 class="modal-title fs-5" id="exampleModalLabel">
										<span class="text-danger">VIDER</span>
										votre panier
									</h1>
									<button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
								</div>
								<div class="modal-body">
									Voulez-vous vraiment supprimer tous les articles du panier ?
								</div>
								<div class="modal-footer">
									<button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
									<a href="{{ path('app_cart_delete')}}" class="btn btn-danger">Supprimer</a>
								</div>
							</div>
						</div>
					</div>


				{% else %}
					<p class="text-center text-bg-danger">Vous devez vous connecter pour valider votre commande</p>
					<a href="{{path('app_login')}}" class='btn btn-dark btn-lg px-4'>IDENTIFIEZ-VOUS</a>
				{% endif %}
			</div>
		{% endif %}

	</div>
{% endblock %}
