						</a>
					</li>
					<li>
						<a href="{{path('app_admin_orders')}}" class="has-icon">
							<span class="icon">
								<span class="mdi mdi-sheep"></span>
							</span>
							<span class="menu-item-label">Commandes</span>
						</a>
					</li>
					<li>
						<a href="{{path('app_admin_users')}}" class="has-icon">
							<span class="icon">
								<i class="mdi mdi-account-circle"></i>
							</span>
							<span class="menu-item-label">Utilisateurs</span>
						</a>
					</li>

				</ul>
